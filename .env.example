# Local default: persistent embedded PostgreSQL, one server process.
# WASLI_DATA_DIR=.data/wasli
# Hosted PostgreSQL: apply migrations manually AFTER approval. No auto-DDL remotely.
# DATABASE_URL=
# Canonical HTTPS application origin is required for production mutations.
# WASLI_APP_ORIGIN=https://your-approved-host
# Local password auth is disabled for production builds by default.
# ALLOW_LOCAL_AUTH=true
# OAuth must be configured in Google Cloud. Never commit actual values.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_REDIRECT_URI=http://localhost:3000/api/integrations/google/callback
# TOKEN_ENCRYPTION_KEY=base64-encoded-32-random-bytes
# WASLI_CRON_SECRET=
